{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "github-bookmarks-sync",
	"compatibility_date": "2026-07-06",
	"compatibility_flags": ["nodejs_als"],
	// Custom entry wrapping the SvelteKit build output to add scheduled()
	"main": "src/worker.ts",
	// Daily sync at 06:00 UTC (free CF cron; deliberately not a Modal slot)
	"triggers": { "crons": ["0 6 * * *"] },
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true
}
